<Application x:Class="ClaudeMd.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1A1D29" />
        <SolidColorBrush x:Key="Muted" Color="#6B7280" />
        <SolidColorBrush x:Key="Line" Color="#E5E7EB" />
        <SolidColorBrush x:Key="PageBack" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Panel" Color="#F8FAFC" />
        <SolidColorBrush x:Key="Accent" Color="#4F46E5" />
        <SolidColorBrush x:Key="AccentDark" Color="#4338CA" />
        <SolidColorBrush x:Key="Green" Color="#16A34A" />
        <SolidColorBrush x:Key="GreenDark" Color="#15803D" />
        <SolidColorBrush x:Key="Amber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AmberDark" Color="#D97706" />

        <!-- vector icons (24 x 24 grid, outlines) -->
        <StreamGeometry x:Key="IcFolder">M3 7 A2 2 0 0 1 5 5 H9 L11 7 H19 A2 2 0 0 1 21 9 V17 A2 2 0 0 1 19 19 H5 A2 2 0 0 1 3 17 Z</StreamGeometry>
        <StreamGeometry x:Key="IcFile">M14 3 H7 A2 2 0 0 0 5 5 V19 A2 2 0 0 0 7 21 H17 A2 2 0 0 0 19 19 V8 Z M14 3 V8 H19 M9 13 H15 M9 17 H15</StreamGeometry>
        <StreamGeometry x:Key="IcEye">M1 12 C1 12 5 4 12 4 C19 4 23 12 23 12 C23 12 19 20 12 20 C5 20 1 12 1 12 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z</StreamGeometry>
        <StreamGeometry x:Key="IcSearch">M11 3 A8 8 0 1 0 11 19 A8 8 0 1 0 11 3 Z M21 21 L16.7 16.7</StreamGeometry>
        <StreamGeometry x:Key="IcCopy">M9 9 H20 V20 H9 Z M5 15 H4 V4 H15 V5</StreamGeometry>
        <StreamGeometry x:Key="IcSync">M21 12 A9 9 0 0 0 6 5.3 L3 8 M3 3 V8 H8 M3 12 A9 9 0 0 0 18 18.7 L21 16 M16 16 H21 V21</StreamGeometry>
        <StreamGeometry x:Key="IcUpload">M12 16 V4 M7 9 L12 4 L17 9 M4 16 V19 A1 1 0 0 0 5 20 H19 A1 1 0 0 0 20 19 V16</StreamGeometry>
        <StreamGeometry x:Key="IcPencil">M12 20 H21 M16.5 3.5 A2.1 2.1 0 0 1 19.5 6.5 L7 19 L3 20 L4 16 Z</StreamGeometry>
        <StreamGeometry x:Key="IcCheck">M20 6 L9 17 L4 12</StreamGeometry>
        <StreamGeometry x:Key="IcLayers">M12 2 L2 7 L12 12 L22 7 Z M2 17 L12 22 L22 17 M2 12 L12 17 L22 12</StreamGeometry>
        <StreamGeometry x:Key="IcChevron">M6 9 L12 15 L18 9</StreamGeometry>
        <Style x:Key="Ic" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.9" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#EEF0F3" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Background" Value="{StaticResource Green}" /></Style>
        <Style x:Key="BtnAmber" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Background" Value="{StaticResource Amber}" /></Style>
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#F1F3F6" CornerRadius="8" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E5E7EB" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnView" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#EEF0FB" BorderBrush="#DDE1F5" BorderThickness="1" CornerRadius="16" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="ic" Style="{StaticResource Ic}" Data="{StaticResource IcEye}" Width="15" Height="15" Stroke="#4F46E5" />
                                <TextBlock x:Name="tx" Text="View" FontWeight="SemiBold" FontSize="13" Foreground="#4F46E5" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E0E4F8" /></Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4F46E5" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4F46E5" />
                                <Setter TargetName="ic" Property="Stroke" Value="White" />
                                <Setter TargetName="tx" Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="#D7DAE0" BorderThickness="1" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F1F3FF" />
                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleArrow" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="22" Height="22">
                            <Path x:Name="ar" Style="{StaticResource Ic}" Data="{StaticResource IcChevron}" Width="12" Height="12" Stroke="#6B7280" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ar" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="bd" CornerRadius="8" Margin="0,1" Background="Transparent" MinHeight="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="ex" Style="{StaticResource ToggleArrow}" ClickMode="Press" Margin="4,0,0,0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="2,0,8,0" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ip" Margin="20,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ip" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="ex" Property="Visibility" Value="Hidden" /></Trigger>
                            <Trigger Property="IsMouseOver" SourceName="bd" Value="True"><Setter TargetName="bd" Property="Background" Value="#EEF0F6" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4F46E5" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
